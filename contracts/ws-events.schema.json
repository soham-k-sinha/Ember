{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ember/ws-events.schema.json",
  "title": "Ember WS events",
  "version": "0.2",
  "description": "Every message on WS /ws is one envelope (authored by Soham, residents/; moved to contracts/ by engine, D38). Every message on WS /ws is one envelope. `seq` increases by 1 per broadcast; a client that sees a gap re-fetches GET /state. The `state` event sent on connect carries the current seq (state as of event N); the next broadcast is N+1. `t_s` = sim clock when the event was emitted. Version 0.2 (D112) adds `arrival`.",
  "type": "object",
  "required": [
    "type",
    "seq",
    "t_s",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "enum": [
        "state",
        "plan",
        "assignment",
        "message",
        "report",
        "scatter_point",
        "metrics",
        "arrival"
      ]
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "t_s": {
      "type": "number",
      "minimum": 0
    },
    "data": {}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "state"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "state.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "plan"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "state.schema.json#/properties/plan/oneOf/1"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "report"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "report.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "message"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "state.schema.json#/properties/messages/items"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "metrics"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "state.schema.json#/$defs/plan_metrics"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "assignment"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/assignment_event"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "scatter_point"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/scatter_point"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "arrival"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/arrival"
          }
        }
      }
    }
  ],
  "$defs": {
    "arrival": {
      "type": "object",
      "description": "A player's vehicle reached them (D112): the clock stops at `t_s` and the backend calls the player with the 'outside now' step. POST /clock answers moves past it with `t_s` clamped and `held_by` = this object, and GET /health shows it as `hold`, until the call ends or a POST /clock with `resume: true`. Only players (phones with a player number) cause one; AUTO_HOLD=0 turns it off.",
      "required": [
        "t_s",
        "household_id",
        "resource_id",
        "resource_name",
        "player",
        "call"
      ],
      "additionalProperties": false,
      "properties": {
        "t_s": {
          "type": "number",
          "minimum": 0,
          "description": "Sim time the vehicle arrives (the plan simulation's arrive time); the clock waits here."
        },
        "household_id": {
          "type": "integer",
          "minimum": 0
        },
        "resource_id": {
          "type": "string"
        },
        "resource_name": {
          "type": "string",
          "description": "e.g. 'Accessible Van 3'."
        },
        "player": {
          "type": "integer",
          "minimum": 1,
          "description": "Player N (join order)."
        },
        "call": {
          "type": "boolean",
          "description": "A call to the player was placed or queued (false: no calls configured or they were texting; the step went by text and the hold lasts until resume)."
        }
      }
    },
    "assignment_event": {
      "type": "object",
      "description": "One changed assignment in a new plan version (one event per entry of plan.changes). `assignment` is null when change = removed.",
      "required": [
        "plan_version",
        "change",
        "assignment_id",
        "assignment"
      ],
      "additionalProperties": false,
      "properties": {
        "plan_version": {
          "type": "integer",
          "minimum": 1
        },
        "change": {
          "enum": [
            "added",
            "removed",
            "retargeted",
            "eta_changed",
            "resource_changed",
            "status_changed"
          ]
        },
        "assignment_id": {
          "type": "string"
        },
        "assignment": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "assignment.schema.json"
            }
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "scatter_point": {
      "type": "object",
      "description": "One robustness run (a plan × one perturbed world) as it comes back from a Daytona sandbox or the local pool. A fan-out for one plan version is one batch: the web clears the scatter when a new batch_id arrives and shows progress as count/n_total. Suggested axes: x = metrics.people_unreached, y = metrics.overflow_m3 (the robust-selection rule is the best worst-20% of people unreached, then overflow). Emitted by engine (ember_engine.compare.scatter_points).",
      "required": [
        "run_id",
        "batch_id",
        "candidate",
        "seed",
        "perturbation",
        "metrics"
      ],
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": "string",
          "description": "Unique per point: '<batch_id>/<candidate>/s<seed>'."
        },
        "batch_id": {
          "type": "string",
          "description": "One fan-out, e.g. 'v3' (plan version) or 'compare'."
        },
        "n_total": {
          "type": "integer",
          "minimum": 1,
          "description": "Points expected in this batch (progress bar)."
        },
        "plan_version": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Plan version the candidates were generated for."
        },
        "candidate": {
          "type": "string",
          "description": "'baseline', 'ember' (the chosen plan), or an allocator candidate id like 'c07'."
        },
        "candidate_label": {
          "type": "string",
          "description": "Human label, e.g. the winning rule 'deadline-first, reserve held, generators dependency'."
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "description": "Perturbation seed; 0 = nominal. Same seed = same perturbed world across candidates (paired)."
        },
        "perturbation": {
          "type": "object",
          "description": "Factors applied, e.g. {travel_time_mult, endurance_scale, storage_scale, inflow_scale, resource_failure, extra_closures}."
        },
        "metrics": {
          "$ref": "state.schema.json#/$defs/plan_metrics"
        },
        "objective": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "The allocator's lexicographic key for this run (lower is better), for ranking."
        },
        "worker": {
          "type": "string",
          "description": "Daytona sandbox id, or 'local'."
        },
        "wall_s": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
