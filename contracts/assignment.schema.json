{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ember/assignment.schema.json",
  "title": "Ember assignment",
  "description": "One resource → one target in a plan version. Computed by the allocator; never generated by an LLM.",
  "type": "object",
  "required": ["id", "plan_version", "resource_id", "task", "target", "eta_s", "status", "rationale"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "description": "Stable across plan versions while the same resource serves the same target."},
    "plan_version": {"type": "integer", "minimum": 1},
    "resource_id": {"type": "string"},
    "task": {"enum": ["rescue", "protect", "clear_road"]},
    "target": {
      "oneOf": [
        {"type": "object", "required": ["household_id"], "additionalProperties": false, "properties": {"household_id": {"type": "integer"}}},
        {"type": "object", "required": ["facility_id"], "additionalProperties": false, "properties": {"facility_id": {"type": "string"}}},
        {"type": "object", "required": ["edge_ids"], "additionalProperties": false, "properties": {"edge_ids": {"type": "array", "items": {"type": "integer"}}}}
      ]
    },
    "dropoff_facility_id": {"type": ["string", "null"], "description": "rescue: where the people are taken."},
    "eta_s": {"type": "number", "minimum": 0, "description": "Sim time of arrival at the target."},
    "deadline_s": {"type": ["number", "null"], "description": "Target's deadline (household) or threatened_at (facility)."},
    "slack_s": {"type": ["number", "null"], "description": "deadline_s − eta_s."},
    "status": {"enum": ["proposed", "offered", "confirmed", "rejected", "en_route", "working", "done", "cancelled"]},
    "rationale": {"type": "string", "description": "One computed line, shown verbatim in the UI."},
    "route_edges": {"type": "array", "items": {"type": "integer"}, "description": "town.json edge ids from the resource's position to the target."},
    "route": {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2}, "description": "The same route as [lon, lat] points (for PathLayer)."}
  }
}
