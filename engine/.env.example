# Copy to engine/.env (gitignored). Read by `ember robust` / `ember daytona-snapshot`.
DAYTONA_API_KEY=            # app.daytona.io → API Keys. Without it the robustness fan-out runs on local processes.
# EMBER_DAYTONA_WORKERS=10  # sandboxes in the pool: ~10 on Tier 1, up to ~100 on Tier 2 (card + $25)
# EMBER_LOCAL_POOL=1        # force local processes even with a key
