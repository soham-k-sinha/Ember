# Copy to residents/.env (gitignored). Never commit real keys.
PHOTON_ENABLED=0                 # 1 = real texts via Photon; 0 = dev mode (stored + broadcast, never sent)
PHOTON_API_KEY=pho_sk_...
PHOTON_PROJECT_ID=
ANTHROPIC_API_KEY=sk-ant-...      # turns on text → report extraction (engine mode only)
# EXTRACT_ENABLED=1
# EXTRACT_MODEL=claude-opus-5-5
# EXTRACT_EFFORT=low
# SCENARIO=../scenarios/allston_flood_v1/scenario.json   # empty = static mode (fixture, no engine)
# START_T_S=0                    # sim clock at startup / reset
# DB_PATH=ember.db               # SQLite file (default residents/ember.db)
# SEED_STATE=../contracts/fixtures/state.fixture.json   # static mode only
# RESET_ON_START=0               # 1 = reseed the DB from SEED_STATE on every start
# DEV_ENDPOINTS=1                # POST /dev/reset (and later /dev/inbound)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:43123,http://127.0.0.1:43123
# PHOTON_LISTEN=1               # 0 = no Socket.IO listener (sends still work)
# OPERATOR_FACILITY_ID=         # default: the critical hospital in the current state
