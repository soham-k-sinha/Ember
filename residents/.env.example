# Copy to residents/.env (gitignored). Never commit real keys.
PHOTON_ENABLED=0                 # 1 = real texts via Photon; 0 = dev mode (stored + broadcast, never sent)
PHOTON_API_KEY=pho_sk_...
PHOTON_PROJECT_ID=
ANTHROPIC_API_KEY=sk-ant-...      # turns on text → report extraction (engine mode only)
# EXTRACT_ENABLED=1
# EXTRACT_MODEL=claude-opus-5-5
# EXTRACT_EFFORT=low
# SCENARIO=../scenarios/allston_flood_v1/scenario.json   # empty = static mode (fixture, no engine)
# START_T_S=0                    # sim clock at startup / reset
# ENGINE_MOVES=                  # allocator search budget per replan (unset = engine default; tests use 10)
# DB_PATH=ember.db               # SQLite file (default residents/ember.db)
# SEED_STATE=../contracts/fixtures/state.fixture.json   # static mode only
# RESET_ON_START=0               # 1 = reseed the DB from SEED_STATE on every start
# DEV_ENDPOINTS=1                # POST /dev/reset (and later /dev/inbound)
# RETRY_EVERY_S=20               # re-send failed outbound texts (same Idempotency-Key)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:43123,http://127.0.0.1:43123
# PHOTON_LISTEN=1               # 0 = no Socket.IO listener (sends still work)
# OPERATOR_FACILITY_ID=         # default: the critical hospital in the current state
# --- the drill (uv run ember-drill; residents README "The drill") ---
# DRILL_RESIDENTS=6175550101,6175550102   # real phones go here, never in git
# DRILL_OPERATORS=6175550103@mt-auburn
# DRILL_SOLO=0                  # 1 = only phones that text in need rescue (ember-drill sets it unless --crowded)
# AUTO_CLOCK=0                  # 1 = a DONE from the last person pending moves the sim clock to the next step
# GEOCODE=1                     # OSM Nominatim for typed addresses (bounded to the town); 0 = intersections/coords only
# --- phone calls (D74; residents README "Calls"): ElevenLabs runs the call on the Photon SMS number ---
# PHOTON_VOICE_NUMBER=+1617...           the Photon SMS/voice number (E.164)
# ELEVENLABS_API_KEY=...                 elevenlabs.io → profile → API Keys
# ELEVENLABS_AGENT_ID=agent_...          Agents → EMBER (under the name / in the URL)
# ELEVENLABS_PHONE_NUMBER_ID=phnum_...   Phone Numbers → the Photon number
# VOICE_PORT=8100                        the voice app (the only thing the tunnel exposes)
# VOICE_ADMIT_CALLERS=1                  unknown callers become residents to be located
# --- understanding + replies (D76) ---
# EXTRACT_MODEL=claude-sonnet-5-5        the one that reads texts/speech into facts
# REPLY_ENABLED=1                        one natural reply per turn (Claude Haiku 5.5 + a guard); 0 = computed messages as-is
# REPLY_MODEL=claude-haiku-5-5
